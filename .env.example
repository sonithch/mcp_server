# Port the server listens on (Render sets this automatically)
PORT=3001

# Static bearer token accepted on /mcp as an alternative to OAuth
# (used by Claude Desktop's header-based config). Generate with:
#   openssl rand -hex 32
MCP_AUTH_TOKEN=

# Secret used to sign/verify our own OAuth access tokens (this server is its
# own OAuth authorization server - see src/oauth.ts). Generate with:
#   openssl rand -hex 32
# If unset, a random secret is generated at boot, meaning every restart
# invalidates all issued tokens (fine for casual use, annoying otherwise).
OAUTH_JWT_SECRET=
