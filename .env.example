# Port the server listens on (Render sets this automatically)
PORT=3001

# Static bearer token accepted on /mcp as an alternative to OAuth
# (used by Claude Desktop's header-based config). Generate with:
#   openssl rand -hex 32
MCP_AUTH_TOKEN=

# Clerk keys. Clerk itself acts as the OAuth authorization server for /mcp -
# we just verify its tokens. Get these from your Clerk dashboard.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# client_id of a PUBLIC (no secret, PKCE-only) OAuth Application created once
# in the Clerk Dashboard. When set, /register fakes Dynamic Client
# Registration by always handing back this same client_id, so any user can
# add the server by URL alone with no manual client_id/secret entry.
CLERK_PUBLIC_CLIENT_ID=
