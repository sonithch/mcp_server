# Port the server listens on (Render sets this automatically)
PORT=3001

# Static bearer token accepted on /mcp as an alternative to OAuth
# (used by Claude Desktop's header-based config). Generate with:
#   openssl rand -hex 32
MCP_AUTH_TOKEN=

# Clerk keys. Clerk itself acts as the OAuth authorization server for /mcp -
# we just verify its tokens. Get these from your Clerk dashboard. To let
# claude.ai connect, create an OAuth Application in the Clerk Dashboard
# (Clerk doesn't support Dynamic Client Registration) and give claude.ai the
# resulting client ID/secret directly.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
