# Port the server listens on (Render sets this automatically)
PORT=3001

# Public base URL of this deployment, used to build OAuth metadata URLs.
# Leave unset locally (falls back to http://localhost:PORT).
# On Render this falls back to RENDER_EXTERNAL_URL automatically.
PUBLIC_URL=

# Static bearer token accepted on /mcp as an alternative to OAuth
# (used by Claude Desktop's header-based config). Generate with:
#   openssl rand -hex 32
MCP_AUTH_TOKEN=

# Clerk keys - gate the OAuth /authorize consent screen so only a signed-up
# Clerk user can approve access. Get these from your Clerk dashboard.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
