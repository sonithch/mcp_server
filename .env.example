# Port the server listens on (Render sets this automatically)
PORT=3001

# The exact externally-reachable origin, scheme included (e.g.
# https://mcp-server-z6uu.onrender.com). better-auth needs this as a fixed
# value to construct redirect_uris/issuer URLs - unlike our own routes, it
# doesn't infer it per-request from forwarded headers.
PUBLIC_URL=

# Static bearer token accepted on /mcp as an alternative to OAuth
# (used by Claude Desktop's header-based config). Generate with:
#   openssl rand -hex 32
MCP_AUTH_TOKEN=

# Signs better-auth's session cookies and internal tokens. Generate with:
#   openssl rand -hex 32
BETTER_AUTH_SECRET=

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials
# > OAuth client ID > Web application). Authorized redirect URI must be
# exactly: ${PUBLIC_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Path to the SQLite database file that stores users, sessions, registered
# OAuth clients, and access tokens (all managed by better-auth). Defaults to
# ./data/auth.db. NOTE: on Render's free tier the filesystem is ephemeral -
# this file is wiped on every deploy/restart, meaning all registered
# clients and logged-in sessions are lost. Attach a persistent disk (or
# point this at a managed Postgres/MySQL instance instead - better-auth
# supports both) if that's not acceptable.
AUTH_DB_PATH=
